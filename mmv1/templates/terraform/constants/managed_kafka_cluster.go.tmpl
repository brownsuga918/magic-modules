// Kafka version upgrades are a two-step process: the broker/controller binaries are
// upgraded first via `binary_version` (reversible), and the metadata version is
// finalized afterwards via `kafka_version` (irreversible). The API rejects requests
// that change both fields at once, so surface that at plan time.
func managedKafkaClusterVersionCustomizeDiffFunc(diff tpgresource.TerraformResourceDiff) error {
	if diff.Id() == "" {
		// Resource creation: both fields may be set together.
		return nil
	}
	if diff.HasChange("binary_version") && diff.HasChange("kafka_version") {
		return fmt.Errorf("`binary_version` and `kafka_version` cannot be changed in the same apply. " +
			"Upgrade the binaries first by setting `binary_version`, then finalize the upgrade in a " +
			"separate apply by setting `kafka_version`.")
	}
	return nil
}

func managedKafkaClusterVersionCustomizeDiff(_ context.Context, diff *schema.ResourceDiff, v interface{}) error {
	return managedKafkaClusterVersionCustomizeDiffFunc(diff)
}
